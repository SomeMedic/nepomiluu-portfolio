# Development: copy to .env (ignored). Production: copy OUTSIDE this checkout,
# e.g. /etc/nepomiluu/portfolio.env, chmod 600, replace every secret.
COMPOSE_PROJECT_NAME=nepomiluu
APP_VERSION=local
DOMAIN=portfolio.example.com
PUBLIC_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:4000
WEB_INTERNAL_URL=http://127.0.0.1:3000
API_HOST=127.0.0.1
API_PORT=4000
MEDIA_DIR=.data/media
INTERNAL_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Development Mongo is loopback-only, without auth. Production must use the
# authenticated URI below; URL-encode username/password if using punctuation.
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio
MONGO_DB=portfolio
MONGO_ROOT_USERNAME=portfolio_root
MONGO_ROOT_PASSWORD=replace-with-a-different-random-secret
# Production values (PUBLIC_ORIGIN=https://portfolio.example.com and
# MONGODB_URI=mongodb://portfolio_root:ENCODED_PASSWORD@mongo:27017/portfolio?authSource=admin)
TLS_CERT_DIR=/etc/nepomiluu/tls
HTTP_PORT=80
HTTPS_PORT=443
HTTP_BIND=0.0.0.0
HTTPS_BIND=0.0.0.0
NODE_IMAGE=node:24.22.0-bookworm-slim@sha256:a5f4366e834695d5f363b920c104953a535d3a9864d1bdf74566a0ebe01daee5
MONGO_IMAGE=mongo:8.0.34@sha256:4a4ab5d4834207389e0d7270fac988e21ffedccecba77991a552f755df229907
NGINX_IMAGE=nginx:1.30.6-alpine@sha256:970364228b1e4f932abc22d321932816782cca8a20b85a77552a7cfe9acfb3b5
# Production backups are outside the checkout and working media volume.
BACKUP_DIR=/var/backups/nepomiluu
# Fixture mode is local preview only. Production API must be reachable.
ALLOW_STATIC_CONTENT=false
